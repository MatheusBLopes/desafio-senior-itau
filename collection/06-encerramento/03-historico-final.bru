meta {
  name: Histórico gravado no Postgres
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auctions/{{auctionId}}/bids?afterSeq=0
  body: none
  auth: none
}

params:query {
  afterSeq: 0
}

tests {
  test("os 3 lances aceitos, com autor e horário", () => {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.lengthOf(3);
    expect(res.body[2].userId).to.equal(bru.getVar("anaUser"));
    expect(res.body[2].acceptedAt).to.be.a("string");
  });
}

docs {
  Os lances foram aceitos no Valkey e gravados no Postgres em segundo plano (write-behind, ~1 s).
}
