meta {
  name: Esperar o fim e ver o vencedor
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/auctions/{{auctionId}}
  body: none
  auth: none
}

script:pre-request {
  // Espera até endsAt (+2 s de folga para o encerramento, que roda a cada 200 ms).
  const espera = new Date(bru.getVar("endsAt")).getTime() - Date.now() + 2000;
  if (espera > 0) {
    console.log(`aguardando ${Math.round(espera / 1000)} s até o fim do leilão`);
    await bru.sleep(espera);
  }
}

tests {
  test("leilão encerrado com a Ana vencedora", () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("CLOSED");
    expect(res.body.acceptingBids).to.equal(false);
    expect(res.body.winnerId).to.equal(bru.getVar("anaUser"));
    expect(res.body.finalPrice).to.equal("120.00");
  });
}

docs {
  O encerramento é atômico no Valkey (script Lua): um lance que chega no mesmo instante ou entra antes
  do fechamento ou é recusado; nunca os dois. Se o WebSocket estiver aberto, chega o `AUCTION_CLOSED`.
}
