meta {
  name: Ana cobre de novo (120.00)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auctions/{{auctionId}}/bids
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAna}}
}

headers {
  Idempotency-Key: {{chave}}
}

body:json {
  {
    "amount": "120.00"
  }
}

script:post-response {
  if (res.body.endsAt) bru.setVar("endsAt", res.body.endsAt);
}

tests {
  test("Ana volta a liderar", () => {
    expect(res.status).to.equal(201);
    expect(res.body.seq).to.equal(3);
    expect(res.body.minimumNextBid).to.equal("125.00");
  });
}
