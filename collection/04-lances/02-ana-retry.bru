meta {
  name: Retry do mesmo lance (idempotente, 200)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auctions/{{auctionId}}/bids
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAna}}
}

headers {
  Idempotency-Key: {{chaveAna}}
}

body:json {
  {
    "amount": "100.00"
  }
}

tests {
  test("devolve o lance original sem duplicar", () => {
    expect(res.status).to.equal(200);
    expect(res.body.seq).to.equal(1);
    expect(res.getHeader("idempotent-replayed")).to.equal("true");
  });
}
